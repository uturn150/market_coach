{
  "name": "4H RSI mean-reversion (template)",
  "params": {
    "period": [
      14,
      28,
      42
    ],
    "os": [
      20,
      25,
      30
    ],
    "ob": [
      70,
      75,
      80
    ]
  },
  "constraints": [
    "os + ob == 100"
  ],
  "risk": {
    "stop_loss_pct": 0.15,
    "trailing_stop_pct": 0.2
  },
  "rules": [
    {
      "when": {
        "left": "rsi:{period}",
        "op": "cross_below",
        "right": "{os}"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "rsi:{period}",
        "op": "cross_above",
        "right": "{ob}"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ],
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "maker_fee_bps": 40.0,
    "half_spread_bps": 5,
    "slippage_bps": 3
  }
}