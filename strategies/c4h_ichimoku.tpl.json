{
  "name": "4H Ichimoku (template)",
  "params": {
    "tenkan": [
      9,
      18,
      36
    ],
    "kijun": [
      26,
      52,
      104
    ]
  },
  "constraints": [
    "tenkan < kijun"
  ],
  "risk": {
    "trailing_stop_pct": 0.15,
    "stop_loss_pct": 0.12
  },
  "entry": {
    "threshold": 2,
    "size": "100%",
    "signals": [
      {
        "name": "tk_cross",
        "when": {
          "left": "ichimoku_tenkan:{tenkan}",
          "op": "cross_above",
          "right": "ichimoku_kijun:{kijun}"
        },
        "weight": 1
      },
      {
        "name": "above_cloud",
        "when": {
          "left": "price",
          "op": ">",
          "right": "ichimoku_senkou_a:{tenkan}:{kijun}"
        },
        "weight": 1
      }
    ]
  },
  "rules": [
    {
      "when": {
        "left": "ichimoku_tenkan:{tenkan}",
        "op": "cross_below",
        "right": "ichimoku_kijun:{kijun}"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ],
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "maker_fee_bps": 40.0,
    "half_spread_bps": 5,
    "slippage_bps": 3
  }
}