{
  "name": "MACD(12,26,9) signal-line crossover [ARENA: hourly, maker/limit orders, experimental]",
  "costs": {
    "order_type": "maker",
    "taker_fee_bps": 26,
    "half_spread_bps": 5,
    "slippage_bps": 3
  },
  "risk": {
    "stop_loss_pct": 0.15,
    "trailing_stop_pct": 0.2
  },
  "rules": [
    {
      "when": {
        "left": "macd_line:12:26",
        "op": "cross_above",
        "right": "macd_signal:12:26:9"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "macd_line:12:26",
        "op": "cross_below",
        "right": "macd_signal:12:26:9"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}