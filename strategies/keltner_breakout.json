{
  "name": "Keltner Channel(20,10,2) breakout",
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "half_spread_bps": 5,
    "slippage_bps": 3,
    "maker_fee_bps": 40.0
  },
  "risk": {
    "trailing_stop_pct": 0.18
  },
  "rules": [
    {
      "when": {
        "left": "price",
        "op": "cross_above",
        "right": "keltner_upper:20:10:2"
