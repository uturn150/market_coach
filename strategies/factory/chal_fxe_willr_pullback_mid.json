{
  "name": "FACTORY EXPLORER willr_pullback mid daily + F1",
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "half_spread_bps": 5,
    "slippage_bps": 3,
    "maker_fee_bps": 40.0
  },
  "risk": {
    "trailing_stop_pct": 0.2,
    "stop_loss_pct": 0.12
  },
  "entry": {
    "threshold": 2,
    "size": "100%",
    "signals": [
      {
        "name": "dip",
        "when": {
          "left": "willr:14",
          "op": "<",
          "right": -90
        },
        "weight": 1
      },
      {
        "name": "trend",
        "when": {
          "left": "price",
          "op": ">",
          "right": "sma:150"
        },
        "weight": 1
      }
    ]
  },
  "rules": [
    {
      "when": {
        "left": "willr:14",
        "op": "cross_above",
        "right": -20
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    },
    {
      "when": {
        "left": "price",
        "op": "cross_below",
        "right": "sma:150"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}