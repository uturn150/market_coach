{
  "name": "Medium swing (template) - wider windows on 6h bars [portfolio+regime] {'fast': 40, 'slow': 160, 'trail': 0.18}",
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 26,
    "half_spread_bps": 5,
    "slippage_bps": 3
  },
  "risk": {
    "trailing_stop_pct": 0.18,
    "stop_loss_pct": 0.1
  },
  "rules": [
    {
      "when": {
        "left": "sma:40",
        "op": "cross_above",
        "right": "sma:160"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "sma:40",
        "op": "cross_below",
        "right": "sma:160"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}