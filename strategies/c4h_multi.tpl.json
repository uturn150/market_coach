{
  "name": "4H multi-signal (template)",
  "params": {
    "threshold": [
      3,
      4
    ],
    "roc_min": [
      0.03,
      0.06
    ],
    "vol_x": [
      1.5,
      2.0
    ],
    "donch": [
      60,
      120
    ]
  },
  "risk": {
    "trailing_stop_pct": 0.2,
    "stop_loss_pct": 0.12
  },
  "entry": {
    "threshold": "{threshold}",
    "size": "100%",
    "signals": [
      {
        "name": "trend",
        "when": {
          "left": "sma:60",
          "op": ">",
          "right": "sma:300"
        },
        "weight": 1
      },
      {
        "name": "breakout",
        "when": {
          "left": "price",
          "op": ">",
          "right": "donchian_high:{donch}"
        },
        "weight": 1
      },
      {
        "name": "momentum",
        "when": {
          "left": "roc:42",
          "op": ">",
          "right": "{roc_min}"
        },
        "weight": 1
      },
      {
        "name": "volume",
        "when": {
          "left": "vol_ratio:120",
          "op": ">",
          "right": "{vol_x}"
        },
        "weight": 1
      },
      {
        "name": "not_overbought",
        "when": {
          "left": "rsi:42",
          "op": "<",
          "right": 75
        },
        "weight": 1
      }
    ]
  },
  "rules": [
    {
      "when": {
        "left": "sma:60",
        "op": "cross_below",
        "right": "sma:300"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ],
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "maker_fee_bps": 40.0,
    "half_spread_bps": 5,
    "slippage_bps": 3
  }
}