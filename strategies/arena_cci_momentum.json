{
  "name": "CCI(20) momentum breakout (>100 buy, <-100 sell) [ARENA: hourly, maker/limit orders, experimental]",
  "costs": {
    "order_type": "maker",
    "taker_fee_bps": 26,
    "half_spread_bps": 5,
    "slippage_bps": 3
  },
  "risk": {
    "trailing_stop_pct": 0.18,
    "stop_loss_pct": 0.12
  },
  "rules": [
    {
      "when": {
        "left": "cci:20",
        "op": "cross_above",
        "right": 100
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "cci:20",
        "op": "cross_below",
        "right": -100
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}