{
  "name": "SMA cross (template) [BTC-USD] {'fast': 30, 'slow': 80, 'stop': 0.1}",
  "fee_bps": 50,
  "slippage_bps": 5,
  "risk": {
    "stop_loss_pct": 0.1
  },
  "rules": [
    {
      "when": {
        "left": "sma:30",
        "op": "cross_above",
        "right": "sma:80"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "sma:30",
        "op": "cross_below",
        "right": "sma:80"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}