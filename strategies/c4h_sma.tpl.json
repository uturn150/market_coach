{
  "name": "4H SMA trend (template)",
  "params": {
    "fast": [
      12,
      24,
      36,
      48
    ],
    "slow": [
      72,
      120,
      180,
      240
    ],
    "trail": [
      0.1,
      0.15
    ]
  },
  "constraints": [
    "fast < slow"
  ],
  "risk": {
    "trailing_stop_pct": "{trail}",
    "stop_loss_pct": 0.12
  },
  "rules": [
    {
      "when": {
        "left": "sma:{fast}",
        "op": "cross_above",
        "right": "sma:{slow}"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "sma:{fast}",
        "op": "cross_below",
        "right": "sma:{slow}"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ],
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "maker_fee_bps": 40.0,
    "half_spread_bps": 5,
    "slippage_bps": 3
  }
}