{
  "name": "4H Donchian/Turtle (template)",
  "params": {
    "entry": [
      60,
      120,
      240
    ],
    "exit": [
      30,
      60,
      120
    ],
    "trail": [
      0.15,
      0.25
    ]
  },
  "constraints": [
    "exit < entry"
  ],
  "risk": {
    "trailing_stop_pct": "{trail}"
  },
  "rules": [
    {
      "when": {
        "left": "price",
        "op": "cross_above",
        "right": "donchian_high:{entry}"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "price",
        "op": "cross_below",
        "right": "donchian_low:{exit}"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ],
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "maker_fee_bps": 40.0,
    "half_spread_bps": 5,
    "slippage_bps": 3
  }
}