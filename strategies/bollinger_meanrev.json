{
  "name": "Bollinger(20,2) mean-reversion (buy lower band dip, sell at mid)",
  "costs": {"order_type": "taker", "taker_fee_bps": 26, "half_spread_bps": 5, "slippage_bps": 3},
  "risk": {"stop_loss_pct": 0.15},
  "rules": [
    {"when": {"left": "price", "op": "cross_below", "right": "bollinger_lower:20:2"},
     "then": {"action": "buy", "size": "100%"}},
    {"when": {"left": "price", "op": "cross_above", "right": "bollinger_mid:20"},
     "then": {"action": "sell", "size": "all"}}
  ]
}
