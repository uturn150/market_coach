{
  "name": "Swing trend (daily, fee-survivable)",
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 60,
    "half_spread_bps": 5,
    "slippage_bps": 3
  },
  "params": {
    "fast": [20, 30, 40, 50],
    "slow": [80, 100, 150, 200],
    "stop": [0.15, 0.25, 0.35]
  },
  "constraints": ["fast < slow"],
  "risk": {"stop_loss_pct": "{stop}"},
  "rules": [
    {"when": {"left": "sma:{fast}", "op": "cross_above", "right": "sma:{slow}"},
     "then": {"action": "buy", "size": "100%"}},
    {"when": {"left": "sma:{fast}", "op": "cross_below", "right": "sma:{slow}"},
     "then": {"action": "sell", "size": "all"}}
  ]
}
