{
  "name": "4H Keltner breakout (template)",
  "params": {
    "n": [
      20,
      40,
      80
    ],
    "atr": [
      10,
      20,
      40
    ],
    "mult": [
      2,
      3
    ],
    "trail": [
      0.1,
      0.15
    ]
  },
  "constraints": [
    "atr <= n"
  ],
  "risk": {
    "trailing_stop_pct": "{trail}"
  },
  "rules": [
    {
      "when": {
        "left": "price",
        "op": "cross_above",
        "right": "keltner_upper:{n}:{atr}:{mult}"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "price",
        "op": "cross_below",
        "right": "keltner_lower:{n}:{atr}:{mult}"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ],
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "maker_fee_bps": 40.0,
    "half_spread_bps": 5,
    "slippage_bps": 3
  }
}