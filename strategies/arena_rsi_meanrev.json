{
  "name": "RSI(14) mean-reversion (oversold<30 buy / overbought>70 sell) [ARENA: hourly, maker/limit orders, experimental]",
  "costs": {
    "order_type": "maker",
    "taker_fee_bps": 26,
    "half_spread_bps": 5,
    "slippage_bps": 3
  },
  "risk": {
    "stop_loss_pct": 0.15,
    "trailing_stop_pct": 0.2
  },
  "rules": [
    {
      "when": {
        "left": "rsi:14",
        "op": "cross_below",
        "right": 30
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "rsi:14",
        "op": "cross_above",
        "right": 70
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}