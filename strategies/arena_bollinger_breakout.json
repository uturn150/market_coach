{
  "name": "Bollinger(20,2) breakout (momentum continuation above upper band) [ARENA: hourly, maker/limit orders, experimental]",
  "costs": {
    "order_type": "maker",
    "taker_fee_bps": 26,
    "half_spread_bps": 5,
    "slippage_bps": 3
  },
  "risk": {
    "trailing_stop_pct": 0.18,
    "stop_loss_pct": 0.12
  },
  "rules": [
    {
      "when": {
        "left": "price",
        "op": "cross_above",
        "right": "bollinger_upper:20:2"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "price",
        "op": "cross_below",
        "right": "bollinger_mid:20"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}