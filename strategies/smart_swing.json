{
  "name": "Smart swing: trend entry + trailing hold",
  "costs": {
    "order_type": "taker",
    "taker_fee_bps": 80.0,
    "half_spread_bps": 5,
    "slippage_bps": 3,
    "maker_fee_bps": 40.0
  },
  "risk": {
    "trailing_stop_pct": 0.18,
    "stop_loss_pct": 0.12
  },
  "rules": [
    {
      "when": {
        "left": "sma:20",
        "op": "cross_above",
        "right": "sma:50"
      },
      "then": {
        "action": "buy",
        "size": "100%"
      }
    },
    {
      "when": {
        "left": "sma:20",
        "op": "cross_below",
        "right": "sma:50"
      },
      "then": {
        "action": "sell",
        "size": "all"
      }
    }
  ]
}